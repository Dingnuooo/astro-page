{
  "name": "astro-theme-pure",
  "type": "module",
  "version": "4.1.6",
  "scripts": {
    "dev": "astro dev",
    "dev:check": "astro check --watch & astro dev",
    "build": "astro-pure check && astro check && astro build",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "astro": "astro",
    "pure": "astro-pure",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "checkall": "bun lint && bun sync && bun check && bun format",
    "yijiansanlian": "npm run clean && npm run cache:snake && npm run build && npm run deploy",
    "clean": "if exist .astro rmdir /s /q .astro & if exist .vercel rmdir /s /q .vercel & if exist dist rmdir /s /q dist",
    "cache:avatars": "tsx preset/scripts/cacheAvatars.ts",
    "cache:snake": "node scripts/cache-snake.mjs",
    "indexnow": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/indexnow.ps1",
    "indexnow:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/indexnow.ps1 -DryRun"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/compiler-rs": "^0.1.10",
    "flexsearch": "^0.8.212",
    "@astrojs/rss": "4.0.18",
    "@astrojs/vercel": "10.0.6",
    "@waline/client": "^3.15.2",
    "astro": "6.4.8",
    "astro-pure": "1.4.9",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-highlight-mark": "^1.4.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "unocss": "66.6.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.1"
  }
}
