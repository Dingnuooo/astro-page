<script is:inline>
  ;(() => {
    const home = document.querySelector('[data-home-scroll]')
    const intro = document.querySelector('[data-home-intro]')
    const content = document.querySelector('[data-home-content]')

    if (
      home instanceof HTMLElement &&
      intro instanceof HTMLElement &&
      content instanceof HTMLElement
    ) {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

      if (reducedMotion.matches) {
        home.classList.add('home-scroll-reduced')
      } else {
        const expand = home.querySelector('[data-home-expand]')
        let frame = 0
        let distance = 1
        let homeTop = 0
        let introHeight = 0
        let lastIncomplete
        let lastContentActive

        const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value))
        const getNaturalTop = (element) => {
          let top = 0
          let current = element

          while (current instanceof HTMLElement) {
            top += current.offsetTop
            current = current.offsetParent
          }

          return top
        }
        const contentEntryProgress = 0.05
        const contentEntryInset = 2

        const measure = () => {
          distance = Number.parseFloat(getComputedStyle(home).paddingTop) || 1
          homeTop = home.getBoundingClientRect().top + window.scrollY
          introHeight = intro.offsetHeight

          const contentNaturalTop = getNaturalTop(content)
          const contentStartShift =
            (window.innerHeight -
              contentEntryInset -
              contentNaturalTop +
              distance * contentEntryProgress) /
            (1 - contentEntryProgress)

          const introLift = Math.min(40, window.innerHeight * 0.045)
          const centeredTop = Math.max(16, (window.innerHeight - introHeight) / 2 - introLift)
          const introStartShift = centeredTop - (homeTop + distance)

          home.style.setProperty('--home-intro-shift-start', `${introStartShift}px`)
          home.style.setProperty('--home-content-shift-start', `${contentStartShift}px`)
        }

        const update = () => {
          frame = 0

          const progress = clamp(window.scrollY / distance)
          const incomplete = progress < 1
          const contentActive = progress > 0.85

          home.style.setProperty('--home-progress', progress.toFixed(4))

          if (incomplete !== lastIncomplete) {
            lastIncomplete = incomplete
            document.body.classList.toggle('home-scroll-incomplete', incomplete)
          }

          if (contentActive !== lastContentActive) {
            lastContentActive = contentActive
            home.classList.toggle('home-content-active', contentActive)
          }

          if (expand instanceof HTMLButtonElement) {
            const isVisible = progress < 0.22
            expand.style.pointerEvents = isVisible ? 'auto' : 'none'
            expand.tabIndex = isVisible ? 0 : -1
          }
        }

        const scheduleUpdate = () => {
          if (!frame) frame = window.requestAnimationFrame(update)
        }

        home.classList.add('home-scroll-enhanced')
        measure()
        update()

        if (expand instanceof HTMLButtonElement) {
          expand.addEventListener('click', () => {
            window.scrollTo({ top: homeTop + distance, behavior: 'smooth' })
          })
        }

        window.addEventListener('scroll', scheduleUpdate, { passive: true })
        window.addEventListener('resize', () => {
          measure()
          scheduleUpdate()
        })
        document.fonts?.ready.then(() => {
          measure()
          scheduleUpdate()
        })
      }
    }

    const profile = document.querySelector('[data-profile-hover]')
    const trigger = document.querySelector('[data-avatar-trigger]')

    if (!(profile instanceof HTMLElement) || !(trigger instanceof HTMLElement)) {
      return
    }

    const activate = () => profile.classList.add('is-clicked')
    const reset = () => profile.classList.remove('is-clicked')

    const toggle = () => {
      if (profile.classList.contains('is-clicked')) {
        reset()
      } else {
        activate()
      }
    }

    trigger.addEventListener('click', toggle)
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault()
        toggle()
      }
    })
    profile.addEventListener('mouseleave', reset)
  })()
</script>

<style>
  .home-scroll-enhanced {
    --home-scroll-distance: clamp(40rem, 100svh, 60rem);
    padding-top: var(--home-scroll-distance);
  }

  .home-scroll-enhanced #content-header {
    z-index: 1;
    opacity: 1;
    animation: none;
    transform: translate3d(
      0,
      calc(var(--home-intro-shift-start, 0px) * (1 - var(--home-progress, 0))),
      0
    );
    will-change: transform;
  }

  .home-scroll-enhanced #content {
    opacity: var(--home-progress, 0);
    animation: none;
    pointer-events: none;
    transform: translate3d(
      0,
      calc(var(--home-content-shift-start, 0px) * (1 - var(--home-progress, 0))),
      0
    );
    will-change: transform, opacity;
  }

  .home-scroll-enhanced.home-content-active #content {
    pointer-events: auto;
  }

  .home-expand-trigger {
    display: none;
  }

  .home-scroll-enhanced .home-expand-trigger {
    position: fixed;
    inset-inline-start: 50%;
    bottom: clamp(7rem, 18svh, 10rem);
    z-index: 20;
    display: flex;
    width: 3.25rem;
    height: 3.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    border-radius: 9999px;
    background-color: hsl(var(--background));
    color: hsl(var(--muted-foreground));
    box-shadow:
      0 12px 30px rgba(24, 24, 27, 0.12),
      0 2px 6px rgba(24, 24, 27, 0.08);
    opacity: calc(1 - (var(--home-progress, 0) * 4.55));
    pointer-events: auto;
    transform: translate3d(-50%, calc(16px * var(--home-progress, 0)), 0);
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
    will-change: transform, opacity;
  }

  .home-scroll-enhanced .home-expand-trigger:hover {
    border-color: hsl(var(--primary));
    color: hsl(var(--primary));
    box-shadow:
      0 16px 36px rgba(24, 24, 27, 0.16),
      0 3px 8px rgba(24, 24, 27, 0.1);
  }

  .home-scroll-enhanced .home-expand-trigger:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 4px;
  }

  :global(.home-expand-trigger svg) {
    transform: rotate(180deg);
  }

  :global(body.home-scroll-incomplete header-component[data-show='false']:not(.expanded)) {
    transform: translateY(0);
  }

  :global(body.home-scroll-incomplete header-component.not-top:not(.expanded)) {
    margin-inline: 0;
    border-color: transparent;
    background-color: transparent;
    padding-inline: 0;
    box-shadow: none;
  }

  .home-scroll-reduced #content-header {
    min-height: calc(100svh - 8rem);
    justify-content: center;
  }

  .profile-hover {
    --avatar-transition: 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .avatar-hover-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 9999px;
  }

  .avatar-layer {
    transition:
      transform var(--avatar-transition),
      box-shadow var(--avatar-transition),
      clip-path 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity var(--avatar-transition);
    will-change: transform, clip-path, opacity;
  }

  .avatar-base {
    position: relative;
    z-index: 0;
  }

  .avatar-alt {
    position: absolute;
    inset: 0;
    z-index: 1;
    clip-path: polygon(120% -10%, 120% 10%, 85% 110%, 85% 90%);
  }

  .avatar-hover-wrap:hover .avatar-layer {
    transform: scale(1.1);
    box-shadow: 0 0 10px 2px rgba(var(--highlight-color-rgb, 214, 231, 255), 0.4);
  }

  .profile-hover.is-clicked .avatar-alt {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }

  .author-switch {
    position: relative;
    display: inline-grid;
    min-height: 1.3em;
  }

  .author-switch > span {
    grid-area: 1 / 1;
    justify-self: center;
    transition:
      transform var(--avatar-transition),
      opacity var(--avatar-transition);
  }

  .author-alt {
    opacity: 0;
    transform: translateY(35%);
  }

  .profile-hover.is-clicked .author-default {
    opacity: 0;
    transform: translateY(-35%);
  }

  .profile-hover.is-clicked .author-alt {
    opacity: 1;
    transform: translateY(0);
  }

  :global(#highlight-gradient) {
    overflow: hidden;
  }

  :global(#highlight-gradient)::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(#7f9be7, transparent);
    opacity: 0;
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(body:has(.profile-hover.is-clicked) #highlight-gradient::after) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-scroll-reduced #content-header {
      animation: none;
      opacity: 1;
    }

    .avatar-layer,
    .author-switch > span,
    :global(#highlight-gradient)::after {
      transition: none;
    }
  }

  @media (min-width: 640px) {
    .author-switch > span {
      justify-self: start;
    }
  }
</style>
