---
import { type IconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'

interface SubstatsItem {
  platform: string
  icon: IconsType
  color?: string
  link?: string
  text?: string
  desc?: string
  api?: string
  count?: number
}

type Props = {
  stats: SubstatsItem[]
}

const { stats } = Astro.props as Props

async function fetchCount(item: SubstatsItem) {
  if (!item.api) return
  try {
    const response = await fetch(`https://api.swo.moe/stats/${item.api}`)
    const data = await response.json()
    if (data.failed) {
      throw new Error(data.message)
    } else {
      item.count = data.count
    }
  } catch (error) {
    console.error(`Error in Substats fetching: ${error}`)
  }
}

await Promise.all(stats.map(fetchCount))
---

<div class='grid grid-cols-1 gap-3 rounded-xl border p-2 sm:grid-cols-2 lg:grid-cols-2 sm:p-3'>
  {
    stats.map(({ link, platform, icon, color, count, text, desc }) => {
      const content = (
        <div class='flex items-center gap-3 rounded-lg border border-transparent px-3 py-2 transition-all hover:border-border hover:bg-muted'>
          {icon && <Icon name={icon} color={color} />}
          <div class='flex-1 text-foreground transition-colors group-hover:text-primary'>
            {platform}
          </div>
          {count ? (
            <div class='flex items-center gap-1.5'>
              <samp>{count}</samp>
              <span class='text-sm font-normal'>{text}</span>
            </div>
          ) : (
            <span class='text-sm font-normal'>{desc}</span>
          )}
        </div>
      )

      return link ? (
        <a
          class='group block text-muted-foreground no-underline'
          href={link}
          target='_blank'
          rel='noopener noreferrer'
        >
          {content}
        </a>
      ) : (
        <button
          type='button'
          class='group w-full cursor-pointer appearance-none border-0 bg-transparent p-0 text-left text-muted-foreground'
          data-copy-substat
          data-copy-value={desc}
          aria-label={`复制 ${platform}`}
        >
          {content}
        </button>
      )
    })
  }
</div>

<script>
  import { showToast } from 'astro-pure/utils'

  document.querySelectorAll<HTMLButtonElement>('[data-copy-substat]').forEach((button) => {
    button.addEventListener('click', () => {
      const value = button.dataset.copyValue
      if (!value) return

      navigator.clipboard.writeText(value)
      showToast({ message: `Copied "${value}" to clipboard!` })
    })
  })
</script>
